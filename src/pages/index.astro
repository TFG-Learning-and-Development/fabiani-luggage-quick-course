---
import { ArrowRight } from '@lucide/astro';
import Navigation from '../components/Navigation.astro';
import SectionHeading from '../components/SectionHeading.astro';
import ProductRange from '../components/ProductRange.astro';
import Benefits from '../components/Benefits.astro';
import Selling from '../components/Selling.astro';
import Conversation from '../components/Conversation.astro';
import Assessment from '../components/Assessment.astro';
import { course } from '../content/course';
import { asset, assetFile } from '../config';
import '../styles/course.css';
---
<!doctype html>
<html lang="en-ZA">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={course.description} />
    <meta name="theme-color" content="#23191d" />
    <meta name="robots" content="noindex, nofollow" />
    <title>{course.title} | Quick Course</title>
  </head>
  <body style={`--pattern-image: url('${assetFile('pattern background.svg')}')`}>
    <Navigation />
    <main id="main">
      <section id="overview" class="overview" aria-labelledby="course-title" data-course-section>
        <div class="hero wrap">
          <h1 id="course-title" class="sr-only">Fabiani Luggage</h1>
          <img src={asset('hero')} width="2564" height="994" alt="Fabiani Luggage black-and-gold crest and wordmark artwork." fetchpriority="high" />
        </div>
        <div class="overview-content wrap">
          <div><h2>{course.overview.title}</h2>{course.overview.paragraphs.map(paragraph => <p>{paragraph}</p>)}</div>
          <figure class="lifestyle-photo"><img src={asset('lifestyle')} width="1200" height="1800" alt="Black Fabiani luggage beside a traveller dressed in light trousers." /><figcaption>&ldquo;{course.overview.quote}&rdquo;</figcaption></figure>
        </div>
      </section>
      <div class="pattern-band">
        <section id="customer-moment" class="section wrap" aria-labelledby="travel-title" data-course-section>
          <SectionHeading id="travel-title" title={course.travel.title} introduction={course.travel.introduction} />
          <ol class="travel-flow" aria-label="Journey to Customer benefit">
            {course.travel.flow.map((label, index) => <li><img src={asset(label.toLowerCase())} width="276" height="276" alt="" loading="lazy" /><span>{label}</span>{index < 3 && <ArrowRight class="flow-arrow" aria-hidden="true" />}</li>)}
          </ol>
          <aside class="dark-note"><h3>Key message:</h3><p>{course.travel.keyMessage}</p></aside>
          <div class="customer-discovery">
            <div class="discovery-quote"><span class="avatar"><img src={asset('customer-avatar')} width="282" height="282" alt="" /></span><p>{course.travel.askIntroduction}</p></div>
            <h3 class="discovery-heading">{course.travel.questionsHeading}</h3>
            <ul class="discovery-questions">{course.travel.questions.map(question => <li><p>{question}</p></li>)}</ul>
          </div>
        </section>
      </div>
      <ProductRange />
      <div class="pattern-band"><Benefits /><Selling /></div>
      <Conversation />
      <Assessment />
    </main>
    <footer class="wrap site-footer">
      <p class="return-label">Return to People Connect to continue</p>
    </footer>
    <script>
      import '../scripts/course';
    </script>
  </body>
</html>
