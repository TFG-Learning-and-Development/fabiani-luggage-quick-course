---
import { ChevronRight, Info } from '@lucide/astro';
import { cases, course } from '../content/course';
import { assetFile } from '../config';
import SectionHeading from './SectionHeading.astro';
---
<section id="product-range" class="section wrap" aria-labelledby="range-title" data-course-section>
  <SectionHeading id="range-title" title={course.range.title} introduction={course.range.introduction} />
  <p class="activity-instruction range-instruction">{course.range.instruction}</p>
  <div class="range-tool" data-range>
    <div class="range-selectors" data-tablist aria-label="Case size">
      {cases.map(item => <button type="button" id={`tab-${item.id}`} data-tab={item.id} aria-controls={`case-${item.id}`}><span>{item.label}</span><ChevronRight size={18} aria-hidden="true" /></button>)}
    </div>
    <div class="range-panels">
      {cases.map(item => <article class="case-panel" id={`case-${item.id}`} data-case={item.id} aria-label={item.label}>
        <figure>
          <img src={assetFile(item.image)} width={item.imageWidth} height={item.imageHeight} alt={item.imageAlt} loading="lazy" />
          {item.imageCaption && <figcaption>{item.imageCaption}</figcaption>}
        </figure>
        <div class="case-copy">
          <h4>Dimensions and capacity</h4>
          <p class="case-dimensions">{item.dimensions.map(dimension => <span>{dimension}</span>)}</p>
          <h4>Best suited to</h4><p>{item.suited}</p>
          <h4>Selling story</h4><p>{item.story}</p>
        </div>
      </article>)}
    </div>
  </div>
  <aside class="dark-note important"><Info size={23} aria-hidden="true" /><div><h3>Important:</h3><p>{course.range.warning}</p></div></aside>
</section>
